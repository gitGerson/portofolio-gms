# Supabase — copy to .env.local and fill with your project's values
# Project URL and anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — NEVER expose to the client / commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Store WhatsApp number used for order confirmation (international format, no +)
NEXT_PUBLIC_STORE_WHATSAPP=6281234567890
